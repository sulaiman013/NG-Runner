<?xml version="1.0" encoding="UTF-8"?>
<!--
  NG Runner: start at sign-in (design section 6, "Auto-start and overnight").
  install.ps1 fills in the values in double braces, saves a UTF-16 copy in <Root>\tasks and
  registers that copy for the signed-in user (no admin rights). Priority 4 is normal priority:
  the default, 7, would run NG Runner below normal. No time limit (PT0S), a second start is
  ignored while one runs, and battery conditions are off. The Run-key fallback starts the same
  launcher; NG Runner's named mutex keeps it to one copy.
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>ICLA</Author>
    <Description>Starts NG Runner when you sign in. NG Runner files each new job's IC summary into NG Jobs.</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>{{USER_SID}}</UserId>
      <Delay>PT30S</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{{USER_SID}}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>4</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{LAUNCHER}}</Command>
      <Arguments>--logon</Arguments>
      <WorkingDirectory>{{WORKING_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
